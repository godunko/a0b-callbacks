with "config/a0b_callbacks_config.gpr";

with "a0b_common.gpr";

library project A0B_Callbacks is

   for Library_Name use "a0b_callbacks";
   for Library_Dir use ".libs/" & A0B_Common.Library_Dir_Suffix;
   for Object_Dir use ".objs/" & A0B_Common.Object_Dir_Suffix;

   for Source_Dirs use ("source");

   package Compiler is
      for Switches ("Ada") use
        A0B_Callbacks_Config.Ada_Compiler_Switches
          & A0B_Common.Compiler_Switches_Ada;
   end Compiler;

end A0B_Callbacks;
